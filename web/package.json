{
  "name": "dleague-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.svelte",
    "format": "prettier -w 'src/**/*.{ts,svelte}'",
    "format:check": "prettier -c 'src/**/*.{ts,svelte}'"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.5.2",
    "firebase": "^11.7.1",
    "phaser": "^3.88.2",
    "svelte": "^5.28.2"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.5.2",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.5",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^22.15.17",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte-check": "^4.1.6",
    "svelte-eslint-parser": "^1.6.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^4.1.5"
  }
}
