# dleague environment variables — copy to .env and fill in.
# Never commit .env. .env.example contains placeholders only.

# ─── Firebase Auth (Spark / free tier) ─────────────────────────────────
# Service-account JSON, single-line stringified (jq -c . < service-account.json).
# Drives Admin SDK token verification + beta-tag user upsert (Phase 5).
FIREBASE_CREDENTIALS_JSON=
# Project ID from Firebase console → Project Settings → General.
FIREBASE_PROJECT_ID=

# ─── Couchbase Community 8.0 (self-hosted) ─────────────────────────────
# Image tag actually used in docker-compose.yml. Fallback if 8.0 ARM64
# manifest is absent: couchbase/server-community:7.6.x
# COUCHBASE_IMAGE_TAG=8.0.0
# Inside docker-compose, hostname is the service name.
COUCHBASE_CONN_STRING=couchbase://couchbase
# Bucket-scoped Application Access user (NOT the cluster admin).
COUCHBASE_USERNAME=dleague_app
COUCHBASE_PASSWORD=change-me-strong-password
COUCHBASE_BUCKET=dleague

# ─── Redis 8.4 (self-hosted, AOF, password-gated) ──────────────────────
# Fallback if 8.4 absent: redis:8.0-alpine (multi-arch).
# REDIS_IMAGE_TAG=8.4-alpine
REDIS_ADDR=redis:6379
REDIS_PASSWORD=change-me-strong-password
