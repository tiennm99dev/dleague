# MongoDB connection string. Used by the server at runtime.
# Local dev (matches docker-compose.yml credentials):
MONGO_URI=mongodb://admin:admin@localhost:27017/?authSource=admin
# Atlas (production):
# MONGO_URI=mongodb+srv://dleague_user:CHANGE_ME@cluster.mongodb.net/dleague?retryWrites=true&w=majority

# Credentials used by docker-compose.yml for the mongo:7 container.
MONGO_USERNAME=admin
MONGO_PASSWORD=admin

# Connection string used only by go test (integration tests).
# Points at a local/CI Mongo instance with a dedicated test database.
MONGO_TEST_URI=mongodb://admin:admin@localhost:27017/dleague_test?authSource=admin

# Maximum concurrent WebSocket connections per server process.
DLEAGUE_MAX_CONNS=1000

# Comma-separated list of allowed WebSocket origins. Required in production.
# Example: DLEAGUE_WS_ORIGINS=https://dleague.example.com,https://www.dleague.example.com
DLEAGUE_WS_ORIGINS=

# Comma-separated list of trusted proxy IPs/CIDRs for X-Forwarded-For.
# Leave empty on direct-access deployments to prevent IP spoofing.
DLEAGUE_TRUSTED_PROXIES=

# Runtime environment. Accepted values: development, production.
DLEAGUE_ENV=development

# Firebase Auth — required for WebSocket auth gate.
# Set FIREBASE_PROJECT_ID to your Firebase project ID.
FIREBASE_PROJECT_ID=dleague-dev

# Local dev: point the Go server at the Firebase Auth emulator.
# Run: firebase emulators:start --only auth --project dleague-dev
# The Firebase Admin SDK picks this up automatically; no service account needed.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Production: path to a service-account JSON file (or use Workload Identity on Fly.io).
# Never commit the JSON file. Keep it out of the repo; reference via env var instead.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount-dleague.json
