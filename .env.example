# dleague environment variables — copy to .env and fill in.
# Never commit .env. .env.example contains placeholders only.

# ─── dleague server ────────────────────────────────────────────────────
# Listen address; matches the published port in docker-compose.yml.
DLEAGUE_ADDR=:8080
# Static web root inside the container — set by the Dockerfile.
# Override only if you bind-mount a different path.
DLEAGUE_WEB=/app/web
# Comma-separated allowlist for the WS upgrade Origin check (CSRF defense).
# Set to your production domain(s); leave blank only for local dev.
DLEAGUE_WS_ORIGINS=https://dleague.example.com

# ─── Firebase Auth (Spark / free tier) ─────────────────────────────────
# Service-account JSON, single-line stringified (jq -c . < service-account.json).
# Drives Admin SDK token verification + beta-tag user upsert (Phase 5).
FIREBASE_CREDENTIALS_JSON=
# Project ID from Firebase console → Project Settings → General.
FIREBASE_PROJECT_ID=

# ─── MongoDB Atlas (managed, SCRAM-SHA-256) ────────────────────────────
# SRV connection string from Atlas → Connect → Drivers → Go.
# See docs/atlas-setup.md for the full runbook.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=dleague-server
MONGODB_URI=
# Database name (default "dleague" if unset).
MONGODB_DB=dleague
